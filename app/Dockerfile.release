# GitHub builds from the repository root: app and integration come from one commit.
FROM ghcr.io/home-assistant/base-debian:bookworm
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml LICENSE /src/
COPY app/src /src/app/src
COPY integration/custom_components /components
RUN pip install --no-cache-dir --break-system-packages /src \
    && rm -rf /src
COPY app/run.sh /run.sh
RUN chmod +x /run.sh
CMD ["/run.sh"]
