#!/usr/bin/env bash
# Build the admin UI (app/web) into the Python package, and Sensor Watch's panel (the same
# sources, vite.panel.config.ts) into its integration, and stamp them with their source
# hash. The output is committed: nothing on the box needs Node. tests/test_web_build.py
# fails if the sources change without running this.
set -euo pipefail
cd "$(dirname "$0")/.."
(cd app/web && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npm run build)
.venv/bin/python tools/web_hash.py --write web
echo "built app/src/casa_mia/web and casa_mia_sensor_watch/www; commit them with the sources"
