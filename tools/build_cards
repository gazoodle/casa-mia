#!/usr/bin/env bash
# Build the Lovelace cards (integration/cards) into the integration's www/cm-cards.js, and
# Sensor Watch's, Love it or Loathe it's and Dash-Bored's each into its own integration's www/cards.js, and stamp them with their source hash. The output is committed: the box needs no Node.
# tests/test_web_build.py fails if the sources change without running this.
set -euo pipefail
cd "$(dirname "$0")/.."
(cd integration/cards && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npm run build && npm test)
.venv/bin/python tools/web_hash.py --write cards
echo "built casa_mia/www/cm-cards.js, and cards.js in casa_mia_sensor_watch/www, casa_mia_love_or_loathe/www and casa_mia_dash_bored/www; commit them with the sources"
