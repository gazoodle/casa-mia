#!/usr/bin/env bash
# Deploy the committed work to the live box: reload the App store, update the app, show its log.
# Needs `tools/fake_git_host.py` running and the version bumped (Rule Zero), else HA sees no update.
# CM_HA_SSH overrides the login; the slug's hash comes from the repository URL in the App store.
set -euo pipefail
cd "$(dirname "$0")/.."
HOST=${CM_HA_SSH:-hassio@homeassistant.local}
SLUG=${CM_APP_SLUG:-a6aa04a6_casa_mia}

if [ -n "$(git status --porcelain)" ]; then
    echo "NOTE: uncommitted changes will NOT be deployed (the fake git host serves commits only)." >&2
fi
sleep 3  # the host re-syncs app-dev every 2 s; let a fresh commit land
# A non-interactive ssh has no login environment, so `ha` would get "missing or invalid API token".
# Fall back to the token s6-overlay keeps for the container.
# A store reload fetches every repository in turn and can outlast the CLI's timeout while the
# Supervisor carries on regardless, so tolerate that and retry the update briefly.
ssh "$HOST" bash -s <<REMOTE
[ -n "\${SUPERVISOR_TOKEN:-}" ] || export SUPERVISOR_TOKEN=\$(cat /run/s6/container_environment/SUPERVISOR_TOKEN)
ha store reload || echo "store reload timed out; the Supervisor usually finishes it anyway" >&2
updated=0
for try in 1 2 3 4 5 6; do
    if ha apps update $SLUG; then updated=1; break; fi
    echo "no update yet (try \$try of 6), waiting..." >&2
    sleep 5
done
[ "\$updated" = 1 ] || { echo "app was not updated: is the version bumped and the fake host running?" >&2; exit 1; }
sleep 5
ha apps logs $SLUG | tail -25
REMOTE
